# MongoDB Atlas (keep credentials server-side; never prefix these with NEXT_PUBLIC_)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=nexus

# Auth.js v5: generate with `npx auth secret` or `openssl rand -base64 32`
AUTH_SECRET=replace-with-a-long-random-secret
AUTH_URL=http://localhost:3000/api/auth
AUTH_TRUST_HOST=true

# Secure cookies are required in deployed HTTPS environments. Set false only for local HTTP development.
AUTH_COOKIE_SECURE=false

# Used only by `npm run seed:admin`; registration never accepts a role.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-unique-password-of-at-least-12-characters

# Upstash Redis (optional): rate limiting for login/register/save/report.
# When unset, rate limiting fails open and all requests are allowed.
UPSTASH_REDIS_REST_URL=https://<your-upstash-endpoint>.upstash.io
UPSTASH_REDIS_REST_TOKEN=<your-upstash-rest-token>
